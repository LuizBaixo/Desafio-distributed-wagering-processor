{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "migration:up": "bun --bun mikro-orm migration:up",
    "migration:down": "bun --bun mikro-orm migration:down",
    "infra:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "infra:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:load": "bun run scripts/load-test.ts",
    "dlq:list": "bun run scripts/dlq.ts list",
    "dlq:redrive": "bun run scripts/dlq.ts redrive",
    "bench:outbox": "bun run scripts/outbox-capacity.ts",
    "check:apresentacao": "bun run docs/apresentacao/check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "nestjs-pino": "5.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.17",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "fast-check": "4.10.2",
    "typescript": "^7.0.2"
  },
  "mikro-orm": {
    "useTsNode": false,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  }
}
