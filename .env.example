# Portas do host usadas pelo docker-compose.yml (padrão entre parênteses).
# Podem colidir com um Postgres ou LocalStack já rodando na máquina: troque se der "port is already allocated".
POSTGRES_PORT=5432
SQS_PORT=4566
APP_PORTS=3001-3003
# Todas as portas acima fazem bind em 127.0.0.1 (ver "Segurança do ambiente local" no README).

# Senhas de desenvolvimento local (somente desenvolvimento local). Os defaults do compose são estes.
# Troque aqui se quiser outras senhas. Em produção não use estes valores.
POSTGRES_PASSWORD=postgres
WAGERING_OWNER_PASSWORD=owner
WAGERING_APP_PASSWORD=app
GRAFANA_ADMIN_PASSWORD=admin

PORT=3000
APP_ROLES=api
DATABASE_URL=postgres://wagering_app:app@localhost:5432/wagering
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
WALLET_EVENTS_QUEUE_NAME=wallet-events.fifo
